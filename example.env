# Required (default configured for OpenAI)
OPENAI_API_KEY=sk-***

# Optional: Use a different model provider
# ANTHROPIC_API_KEY=sk-ant-***
# GOOGLE_API_KEY=***

# Exa API key for web research
# EXA_API_KEY=***

# Documents directory (sample docs ship in ./documents, mounted as /documents in Docker)
# DOCUMENTS_DIR=/documents

# Database (defaults work out of the box)
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai

# ---------------------------------------------------------------------------
# Directory sign-in (LDAP / Active Directory) — optional, OFF by default
# ---------------------------------------------------------------------------
# The sign-in screen does not change. People type the same email and password;
# if the local password does not match, and the account already exists in Legal
# Scout, the same credentials are offered to the directory instead.
#
# The directory proves WHO somebody is. Roles and access still live in this
# application's `users` table and are set in the admin panel — nothing in an
# LDAP group can grant a role here.
#
# An administrator still creates each account (Settings -> Users). Leave the
# password blank there and the person signs in with their directory password;
# nothing is stored here for them. A directory user with no account is refused.
LDAP_ENABLED=false
LDAP_HOST=ldap.corp.example.com
LDAP_PORT=636
LDAP_USE_SSL=true              # or LDAP_PORT=389 with LDAP_START_TLS=true
LDAP_START_TLS=false
LDAP_VALIDATE_CERT=true
LDAP_CA_CERT_FILE=             # only for a private CA
LDAP_BIND_DN=cn=svc-legalscout,ou=service,dc=corp,dc=com
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=ou=users,dc=corp,dc=com
# The form collects an EMAIL, so the filter matches the mail attribute.
# (sAMAccountName={username}) would need a bare username and will match nothing.
LDAP_USER_FILTER=(mail={username})
LDAP_EMAIL_ATTR=mail
LDAP_NAME_ATTR=cn
LDAP_LABEL=Corporate directory
LDAP_TIMEOUT=8
# The flow rebinds as the user, so their password crosses the wire on every
# sign-in. Without TLS it crosses it readable, and without certificate
# validation the server on the other end is whoever answered. Startup REFUSES
# that combination; this is the explicit override, for a lab only.
LDAP_ALLOW_INSECURE=false

# ---------------------------------------------------------------------------
# Single sign-on (OpenID Connect) — optional, OFF by default
# ---------------------------------------------------------------------------
# Works with Keycloak, Microsoft Entra, Google, or any compliant provider.
# When enabled, the sign-in screen shows a "Continue with ..." button; when
# not, the button is not rendered at all.
#
# The provider proves WHO somebody is. An administrator still creates the
# account in Settings -> Users, and roles still live in this application.
# Nothing in a token, group or role mapper grants access here — so whoever
# administers your realm cannot make themselves a Legal Scout administrator.
#
# OIDC_REDIRECT_URI must byte-match a redirect URI registered on the client, or
# the provider rejects the request before it ever reaches this application.
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=https://keycloak.example.com/realms/cityholdings/.well-known/openid-configuration
OIDC_CLIENT_ID=legal-scout
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://legalscout.example.com/api/auth/sso/callback
OIDC_SCOPES=openid email profile
OIDC_LABEL=City Holdings SSO
OIDC_PROVIDER_TYPE=keycloak
# If the provider sends email_verified and it is false, refuse the sign-in.
# A provider that omits the claim is unaffected.
OIDC_REQUIRE_VERIFIED_EMAIL=true
OIDC_TIMEOUT=10
